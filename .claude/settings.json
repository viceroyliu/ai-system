{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/Users/viceroy/ai-system/web/node_modules/**)",
      "Read(/Users/viceroy/ai-system/web/.next/**)",
      "Read(/Users/viceroy/ai-system/**/*.tsbuildinfo)",
      "Read(/Users/viceroy/ai-system/**/package-lock.json)",
      "Read(/Users/viceroy/ai-system/**/yarn.lock)",
      "Read(/Users/viceroy/ai-system/**/*.pid)",
      "Read(/Users/viceroy/ai-system/data/webui.db)",
      "Read(/Users/viceroy/ai-system/data/**/*.sqlite3)",
      "Read(/Users/viceroy/ai-system/data/**/*.sqlite3-*)",
      "Glob(/Users/viceroy/ai-system/web/node_modules/**)",
      "Glob(/Users/viceroy/ai-system/web/.next/**)",
      "Grep(/Users/viceroy/ai-system/web/node_modules/**)",
      "Grep(/Users/viceroy/ai-system/web/.next/**)"
    ],
    "ask": [
      "Read(/Users/viceroy/ai-system/logs/**)",
      "Read(/Users/viceroy/ai-system/data/*.log)",
      "Read(/Users/viceroy/ai-system/data/*.err)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' 2>/dev/null | grep -E -q '/ai-system/logs/|/ai-system/web/node_modules|/ai-system/web/\\.next|chroma\\.sqlite|webui\\.db|\\.tsbuildinfo|package-lock\\.json|/ai-system/.*\\.err|/ai-system/data/.*\\.log' && printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"命令触及大文件/日志/安装包路径，避免污染上下文。如需确认请点击允许。\"}}' || true"
          }
        ]
      }
    ]
  }
}
